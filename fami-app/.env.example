# Database
DATABASE_URL=file:./fami.db

# NextAuth
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (Phase 6 admin uploads + PDP video)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order notification email (Resend or SMTP)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=orders@famibd.shop

# Customer-facing WhatsApp quick-order number (E.164, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# Analytics (optional — scripts are not injected when these are absent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
